---
import '../styles/global.css';
import { site } from '../site.config';

interface Props {
	title: string;
	description?: string;
	breadcrumbs?: Array<{ name: string; url: string }>;
	ogType?: 'website' | 'article';
	article?: { pubDate: Date; updatedDate?: Date; tags?: string[] };
	schemas?: Record<string, unknown>[];
}

const canonicalURL = new URL(Astro.url.pathname, site.url);
const { title, description = site.description, breadcrumbs, ogType = 'website', article, schemas = [] } = Astro.props;
const ogImage = site.ogImage;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonicalURL.href} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL.href} />
		{article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
		{article?.updatedDate && <meta property="article:modified_time" content={article.updatedDate.toISOString()} />}
		{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
		<meta property="og:site_name" content={site.name} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Schema.org JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": site.maintainer.name,
			"url": site.maintainer.url,
			"description": `Publisher of ${site.name}.`
		})} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": site.name,
			"url": site.url,
			"description": site.description,
			"publisher": {
				"@type": "Organization",
				"name": site.maintainer.name,
				"url": site.maintainer.url
			}
		})} />
		{breadcrumbs && (
			<script type="application/ld+json" set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "BreadcrumbList",
				"itemListElement": breadcrumbs.map((item, i) => ({
					"@type": "ListItem",
					"position": i + 1,
					"name": item.name,
					"item": item.url
				}))
			})} />
		)}
		{schemas.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...schema })} />
		))}
		<link rel="alternate" type="application/rss+xml" title={`${site.rssTitle} blog`} href="/rss.xml" />

		<!-- One family, two cuts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Geist:wght@400;500;600&display=swap" rel="stylesheet">

		{site.gaMeasurementId && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaMeasurementId}`}></script>
				<script is:inline define:vars={{ gaId: site.gaMeasurementId }}>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', gaId);
				</script>
			</>
		)}
	</head>
	<body class="min-h-dvh flex flex-col">
		<header class="w-full max-w-3xl mx-auto px-6 pt-10 pb-2">
			<div class="flex items-baseline justify-between gap-6">
				<a href="/" class="text-[15px] font-medium tracking-tight text-stone-900 dark:text-zinc-100 hover:text-coral-600 dark:hover:text-coral-400 transition-colors">
					{site.wordmark}
				</a>
				<nav class="flex items-center gap-5 text-[15px]">
					{site.nav.map((item) => (
						<a href={item.href} class="text-stone-500 dark:text-zinc-500 hover:text-coral-600 dark:hover:text-coral-400 transition-colors">{item.label}</a>
					))}
				</nav>
			</div>
		</header>

		<main class="flex-1 w-full max-w-3xl mx-auto px-6 pt-12 pb-24">
			<slot />
		</main>

		<footer class="w-full max-w-3xl mx-auto px-6 pb-14">
			<p class="border-t border-stone-200 dark:border-zinc-800 pt-6 text-sm text-stone-500 dark:text-zinc-500 text-pretty">
				{site.footerLine} <a href="/about" class="underline hover:text-coral-600 dark:hover:text-coral-400">About</a>. <a href="/rss.xml" class="underline hover:text-coral-600 dark:hover:text-coral-400">RSS</a>.
			</p>
		</footer>
	</body>
</html>
