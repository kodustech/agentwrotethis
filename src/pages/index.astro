---
import Layout from '../layouts/Layout.astro';
import { getPublishedPosts, CATEGORY_LABELS } from '../lib/blog';

const posts = await getPublishedPosts();

// Grouped by year, newest first. A blog index is a chronology, not a feed of cards.
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const y = post.data.pubDate.getFullYear();
	byYear.set(y, [...(byYear.get(y) ?? []), post]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const fmtDay = (d: Date) =>
	d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', timeZone: 'UTC' });

const title = "Reviewing code an agent wrote | agentwrotethis.dev";
---

<Layout title={title}>
	<section class="mb-16 max-w-[62ch]">
		<p class="text-lg text-stone-700 dark:text-zinc-300 leading-relaxed text-pretty">
			Notes on reviewing code an agent mostly wrote. What breaks in the workflow, what other teams are publishing about their own review load, and which tools hold up when you check the claim.
		</p>
	</section>

	{years.map((year) => (
		<section class="mb-14">
			<h2 class="rubric mb-4">{year}</h2>
			<ul class="border-t border-stone-200 dark:border-zinc-800">
				{byYear.get(year)!.map((post) => (
					<li class="border-b border-stone-200 dark:border-zinc-800">
						<a href={`/blog/${post.id}`} class="group block py-4 sm:grid sm:grid-cols-[5.5rem_minmax(0,1fr)] sm:gap-6">
							<time class="meta block sm:pt-[3px]" datetime={post.data.pubDate.toISOString()}>
								{fmtDay(post.data.pubDate)}
							</time>
							<div class="min-w-0">
								<h3 class="text-[17px] font-medium text-stone-900 dark:text-zinc-100 group-hover:text-coral-600 dark:group-hover:text-coral-400 transition-colors mt-1 sm:mt-0">
									{post.data.title}
								</h3>
								<p class="text-[15px] text-stone-600 dark:text-zinc-400 mt-1 text-pretty leading-relaxed">
									{post.data.description}
								</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		</section>
	))}

	{posts.length === 0 && (
		<section class="border-t border-stone-200 dark:border-zinc-800 pt-6">
			<p class="text-stone-600 dark:text-zinc-400">
				Nothing published yet. The first notes are being written. <a href="/rss.xml" class="text-coral-600 dark:text-coral-400 underline">The feed</a> is live if you want them when they land.
			</p>
		</section>
	)}
</Layout>
