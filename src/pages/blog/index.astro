---
import Layout from '../../layouts/Layout.astro';
import { getPublishedPosts, CATEGORY_LABELS, readingTime, formatDate, SITE_URL } from '../../lib/blog';

const posts = await getPublishedPosts();
const categories = [...new Set(posts.map((p) => p.data.category))];

const title = "Writing | agentwrotethis.dev";
const description = "Comparisons, alternatives and evaluation guides for code review tools, for teams where agents write most of the code.";
---

<Layout
	title={title}
	description={description}
	breadcrumbs={[
		{ name: 'Home', url: `${SITE_URL}/` },
		{ name: 'Blog', url: `${SITE_URL}/blog/` }
	]}
	schemas={[{
		"@type": "Blog",
		"name": "agentwrotethis.dev blog",
		"url": `${SITE_URL}/blog/`,
		"description": description,
		"publisher": { "@type": "Organization", "name": "agentwrotethis.dev", "url": `${SITE_URL}/about/` }
	}]}
>
	<section class="mb-12 max-w-[62ch]">
		<h1 class="text-2xl font-medium text-stone-900 dark:text-zinc-100 mb-3">Everything, newest first</h1>
		<p class="text-stone-600 dark:text-zinc-400 leading-relaxed text-pretty">
			Filter by kind if you are after something specific. Every claim about a tool links to the page it came from.
		</p>
	</section>

	{categories.length > 1 && (
		<nav class="flex flex-wrap gap-x-5 gap-y-2 mb-10 text-[15px]" aria-label="Categories">
			{categories.map((cat) => (
				<a href={`/blog/category/${cat}`} class="text-stone-500 dark:text-zinc-500 hover:text-coral-600 dark:hover:text-coral-400 transition-colors">
					{CATEGORY_LABELS[cat] ?? cat}
				</a>
			))}
		</nav>
	)}

	<ul class="border-t border-stone-200 dark:border-zinc-800">
		{posts.map((post) => (
			<li class="border-b border-stone-200 dark:border-zinc-800">
				<a href={`/blog/${post.id}`} class="group block py-4 sm:grid sm:grid-cols-[6.5rem_minmax(0,1fr)] sm:gap-6">
					<time class="meta block sm:pt-[3px]" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
					<div class="min-w-0">
						<h2 class="text-[17px] font-medium text-stone-900 dark:text-zinc-100 group-hover:text-coral-600 dark:group-hover:text-coral-400 transition-colors mt-1 sm:mt-0">{post.data.title}</h2>
						<p class="text-[15px] text-stone-600 dark:text-zinc-400 mt-1 text-pretty leading-relaxed">{post.data.description}</p>
					</div>
				</a>
			</li>
		))}
	</ul>

	{posts.length === 0 && (
		<p class="text-stone-600 dark:text-zinc-400 pt-6">Nothing published yet. The first notes are being written.</p>
	)}
</Layout>
